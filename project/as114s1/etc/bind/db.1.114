$TTL 604800
@   IN  SOA ns.isp114.lab. admin.isp114.lab. (
        2025092501 ; Serial
        604800     ; Refresh
        86400      ; Retry
        2419200    ; Expire
        604800 )   ; Negative Cache TTL
;
@       IN  NS  ns.isp114.lab.

; PTRs for 1.114.0.x subnet
0.0     IN  PTR eth1r1.isp114.lab.
0.1     IN  PTR eth1r2.isp114.lab.
0.2     IN  PTR eth2r1.isp114.lab.
0.3     IN  PTR eth2r3.isp114.lab.
0.4     IN  PTR eth3r1.isp114.lab.
0.5     IN  PTR eth1r4.isp114.lab.
0.6     IN  PTR eth2r4.isp114.lab.
0.7     IN  PTR eth1r3.isp114.lab.
0.8     IN  PTR eth2r2.isp114.lab.
0.9     IN  PTR eth3r3.isp114.lab.

; PTRs for 1.114.1.x subnet
1       IN  PTR eth0r3.isp114.lab.
2       IN  PTR ns.isp114.lab.
3       IN  PTR www.isp114.lab.
4       IN  PTR dhcpd.isp114.lab.

; PTRs for 1.114.2.x subnet (dummy interfaces)
2.1     IN  PTR dummy0r1.isp114.lab.
2.2     IN  PTR dummy0r2.isp114.lab.
2.3     IN  PTR dummy0r3.isp114.lab.
2.4     IN  PTR dummy0r4.isp114.lab.

; PTRs for 1.114.100.x subnet
100.1   IN  PTR eth0r4.isp114.lab.
100.11  IN  PTR c1.isp114.lab.
100.12  IN  PTR c2.isp114.lab.

